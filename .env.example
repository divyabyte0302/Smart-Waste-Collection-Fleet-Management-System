# ==============================================================================
# Smart Waste Collection Management System - Production Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Amazon RDS PostgreSQL Database Connection
# Format: postgres://<DB_USER>:<DB_PASSWORD>@<RDS_HOST>:5432/<DB_NAME>?sslmode=require
DATABASE_URL=postgres://postgres:YourSecurePassword123!@smartwaste-prod-db.c123456789.us-east-1.rds.amazonaws.com:5432/smartwaste_db

# JWT Authentication Security
JWT_SECRET=production_ultra_secure_jwt_secret_token_9837492837492847293847923
JWT_EXPIRES_IN=7d

# AWS Cloud Infrastructure Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Amazon S3 Asset Storage
AWS_S3_BUCKET=smartwaste-bucket-production

# Amazon SNS Notification Engine
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:smartwaste-notifications-topic

# Amazon CloudWatch Observability
CLOUDWATCH_LOG_GROUP=/aws/smartwaste/backend

# CORS Allowed Origins (comma-separated for production frontend domains)
CORS_ALLOWED_ORIGINS=https://main.d123456789.amplifyapp.com,https://smartwaste.gov,http://localhost:3000

# Frontend Environment Configuration
VITE_API_BASE_URL=https://api.smartwaste.gov
