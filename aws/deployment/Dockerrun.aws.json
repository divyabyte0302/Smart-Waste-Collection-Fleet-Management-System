{
  "AWSEBDockerrunVersion": "1",
  "Image": {
    "Name": "node:18-alpine",
    "Update": "true"
  },
  "Ports": [
    {
      "ContainerPort": "5000"
    }
  ],
  "Logging": "/var/log/smartwaste-backend",
  "Volumes": [
    {
      "HostDirectory": "/var/app/current/uploads",
      "ContainerDirectory": "/usr/src/app/uploads"
    }
  ]
}
